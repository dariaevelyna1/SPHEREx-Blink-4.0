# SPHEREx Blink 4.0 backend configuration. Copy to .env (git-ignored) or set in the shell / the container.
# This file holds NAMES and placeholders only. Never put a key, a token or a service-account file in the repository.

# "edu" (synthetic bundle, the default) or "full" (processed sequences from a store).
BLINK_PROFILE=edu

# ---- full profile: storage (decision 8 is the author's: bucket, prefix and region are placeholders) ----
# Local store (a folder laid out as docs/DATA_CONTRACT.md section 9). Used when GCS_BUCKET is empty.
SPHEREX_DATA_DIR=backend/data/store
# Google Cloud Storage store. Auth is Application Default Credentials; there is no key variable on purpose.
GCS_BUCKET=
GCS_PREFIX=
GOOGLE_CLOUD_PROJECT=spherex-blink
# Local read-through cache of store objects (git-ignored), capped in megabytes.
BLINK_CACHE_DIR=backend/.cache
BLINK_CACHE_MAX_MB=256

# ---- full profile: what may be served (decisions 1 and 4 are the author's; both stay false until then) ----
REAL_DATA_ENABLED=false
SERVE_PIXELS=false
# The allow-list of approved sequences (ships empty).
APPROVED_SEQUENCES_FILE=backend/approved_sequences.json

# ---- public limits ----
CORS_ALLOW_ORIGINS=http://localhost:8765
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_REQUESTS=8
REQUEST_TIMEOUT_SECONDS=20
MAX_PAGE_SIZE=50

# ---- admin endpoints ----
# Set at run time in the environment of the server, typed by the author. Leave empty here. Empty = admin endpoints disabled.
ADMIN_TOKEN=
